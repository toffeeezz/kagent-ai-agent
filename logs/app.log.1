  required property real basePrice
  readonly property color accent: "#E8B84F"

  Layout.fillWidth: true
  Layout.preferredHeight: 280
  radius: 12
  color: "white"

  // Soft shadow so the card floats
  DropShadow {
    enabled: true
  }

  ColumnLayout {
    anchors.fill: parent
    anchors.margins: 16
    spacing: 8

    // Thumbnail area
    Rectangle {
      Layout.fillWidth: true
      Layout.preferredHeight: 160
      radius: 8
      color: "#F5F5F5"

      Text {
        anchors.centerIn: parent
        text: "📷 " + root.name
        font.pixelSize: 14
        color: "#6B6B6B"
      }
    }

    // Room name
    Text {
      text: root.name
      font.pixelSize: 18
      font.weight: Font.Bold
      color: "#1E1E1E"
    }

    // Price row
    RowLayout {
      Layout.fillWidth: true

      Text {
        text: "From "
        font.pixelSize: 14
        color: "#6B6B6B"
      }

      Text {
        text: "€" + root.basePrice
        font.pixelSize: 20
        font.weight: Font.Bold
        color: root.accent
      }

      Text {
        text: " / night"
        font.pixelSize: 14
        color: "#6B6B6B"
      }
    }
  }

  // ─── Hover popover: review preview ───
  Rectangle {
    id: popover
    anchors.top: root.bottom
    anchors.left: root.left
    anchors.margins: 0
    width: root.width
    implicitHeight: popoverContent.implicitHeight + 32
    radius: 12
    color: "white"

    visible: hover.hovered

    Behavior on opacity {
      NumberAnimation {
        from: 0; to: 1
        duration: 150
        easing: Easing.InOutSine
      }
    }

    Behavior on anchors.topMargin {
      NumberAnimation {
        from: -8; to: 0
        duration: 150
        easing: Easing.InOutSine
      }
    }

    DropShadow {
      enabled: popover.visible
    }

    ColumnLayout {
      id: popoverContent
      anchors.fill: parent
      anchors.margins: 16
      spacing: 6

      // Star rating row
      RowLayout {
        Layout.fillWidth: true
        spacing: 4

        Repeater {
          model: 5

          Rectangle {
            required property int modelData
            width: 14; height: 14
            radius: 7
            color: modelData <= 4 ? root.accent : "#E0E0E0"
          }
        }

        Item { Layout.fillWidth: true }

        Text {
          text: "4.0"
          font.pixelSize: 14
          font.weight: Font.Bold
          color: root.accent
        }
      }

      // Review text
      Text {
        text: "“Spacious room with a beautiful view. The bed was incredibly comfortable. Would definitely stay again.”"
        font.pixelSize: 13
        wrapMode: Text.WordWrap
        color: "#1E1E1E"
      }

      // Reviewer
      Text {
        text: "— Sarah, June 2025"
        font.pixelSize: 12
        color: "#6B6B6B"
      }
    }
  }

  HoverHandler {
    id: hover
    cursorShape: Qt.PointingHandCursor
  }
}
```

### What it does

- **Normal state** — the room card shows name, thumbnail placeholder, and price
- **Hover** — the popover drops down from the bottom of the card with a smooth fade + slide animation (150ms, same rhythm as your `NavLink` underline)
- **Popover contains** — star rating (filled circles using your accent color), the numeric score, a review quote, and the reviewer name
- **Shadow** on both the card and the popover so they layer properly over the grid

### If you want it to overlay *on top* of the card instead of below

Change the popover anchors from `anchors.top: root.bottom` to `anchors.fill: parent` and it'll sit right over the card content. You'd probably also want to dim the card behind it — just add a `Rectangle` overlay with `color: "#88000000"` (semi-transparent black) that shows when `hover.hovered` is true. But the drop-below approach keeps the card fully readable and feels more natural for a grid layout.
