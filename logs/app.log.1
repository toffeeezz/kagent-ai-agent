yout {\n        id: page\n\n        x: root.pageMargin\n        y: 28\n        width: scroller.width - 2 * root.pageMargin\n        spacing: 20\n\n        // ─── Title ───\n        ColumnLayout {\n          Layout.fillWidth: true\n          spacing: 4\n\n          Text {\n            text: "Find your room"\n            font.pixelSize: 30\n            font.weight: Font.Bold\n            color: "#1E1E1E"\n          }\n\n          Text {\n            text: controller.roomListModel.count + (controller.roomListModel.count === 1 ? " room " : " rooms ") + (root.filtersActive ? "match your filters" : "available to browse")\n            font.pixelSize: 14\n            color: "#6B6B6B"\n          }\n        }\n\n        // ─── Search & price filters ───\n        Rectangle {\n          Layout.fillWidth: true\n          Layout.preferredHeight: bar.height + 32\n          radius: 16\n          color: "white"\n          border.color: "#E4E4E4"\n\n          Flow {\n            id: bar\n\n            x: 16\n            y: 16\n            width: parent.width - 32\n            spacing: 14\n\n            FilterField {\n              id: checkIn\n              label: "Check-in"\n              placeholder: "YYYY-MM-DD"\n              validator: RegularExpressionValidator {\n                regularExpression: /^\\d{0,4}(-\\d{0,2}(-\\d{0,2})?)?$/\n              }\n              onSubmitted: root.applyFilters()\n            }\n\n            FilterField {\n              id: checkOut\n              label: "Check-out"\n              placeholder: "YYYY-MM-DD"\n              validator: RegularExpressionValidator {\n                regularExpression: /^\\d{0,4}(-\\d{0,2}(-\\d{0,2})?)?$/\n              }\n              onSubmitted: root.applyFilters()\n            }\n\n            ColumnLayout {\n              spacing: 4\n\n              Text {\n                text: "Guests"\n                font.pixelSize: 11\n                font.weight: Font.Medium\n                color: "#6B6B6B"\n          