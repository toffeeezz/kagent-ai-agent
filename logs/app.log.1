e: input.echoMode\n    property alias inputMethodHints: input.inputMethodHints\n    signal submitted\n\n    function focusInput() {\n      input.forceActiveFocus();\n    }\n\n    spacing: 4\n\n    Text {\n      text: field.label\n      font.pixelSize: 11\n      font.weight: Font.Medium\n      color: "#6B6B6B"\n    }\n\n    TextField {\n      id: input\n\n      Layout.fillWidth: true\n      Layout.preferredHeight: 40\n      font.pixelSize: 13\n      color: "#1E1E1E"\n      placeholderTextColor: "#A0A0A0"\n      leftPadding: 12\n      verticalAlignment: TextInput.AlignVCenter\n      onAccepted: field.submitted()\n\n      background: Rectangle {\n        radius: 10\n        color: "white"\n        border.color: input.activeFocus ? "#E8B84F" : "#E4E4E4"\n      }\n    }\n  }\n\n  ColumnLayout {\n    anchors.fill: parent\n    spacing: 0\n\n    Header {\n      current: ""\n      onNavigate: page => root.navigateRequested(page)\n    }\n\n    Flickable {\n      id: scroller\n\n      Layout.fillWidth: true\n      Layout.fillHeight: true\n      contentWidth: width\n      contentHeight: page.y + page.implicitHeight + 48\n      boundsBehavior: Flickable.StopAtBounds\n      clip: true\n\n      ScrollBar.vertical: ScrollBar {\n        policy: ScrollBar.AsNeeded\n      }\n\n      ColumnLayout {\n        id: page\n\n        width: Math.min(root.formMaxWidth, scroller.width - 2 * root.pageMargin)\n        x: (scroller.width - width) / 2\n        y: 40\n        spacing: 20\n\n        // ─── Title ───\n        ColumnLayout {\n          Layout.fillWidth: true\n          spacing: 4\n\n          Text {\n            text: "Welcome back"\n            font.pixelSize: 30\n            font.weight: Font.Bold\n            color: "#1E1E1E"\n          }\n\n          Text {\n            text: "Log in to book rooms and manage your reservations."\n            font.pixelSize: 14\n            color: "#6B6B6B"\n            wrapMode: Text.WordWrap\n            Layout.fillWidth: true\n          }\n        }\n\n        // ─── Form ───\n        Rectangle {\n          Layout.fillWidth: true\n          Layout.preferredHeight: formCol.implicitHeight + 40\n          radius: 16\n          color: "white"\n          border.color: "#E4E4E4"\n\n          ColumnLayout {\n            id: formCol\n\n            x: 20\n            y: 20\n            width: parent.width - 40\n            spacing: 14\n\n            FormField {\n              id: email\n              Layout.fillWidth: true\n              label: "Email"\n              placeholder: "you@example.com"\n              inputMethodHints: Qt.ImhEmailCharactersOnly | Qt.ImhNoAutoUppercase\n              onSubmitted: password.focusInput()\n            }\n\n            FormField {\n              id: password\n              Layout.fillWidth: true\n              label: "Password"\n              placeholder: "Password"\n              echoMode: root.showPassword ? TextInput.Normal : TextInput.Password\n              onSubmitted: root.submit()\n            }\n\n            Text {\n              text: root.showPassword ? "Hide password" : "Show password"\n              font.pixelSize: 12\n              font.weight: Font.Medium\n              color: showHover.hovered ? "#1E1E1E" : "#6B6B6B"\n\n              HoverHandler {\n                id: showHover\n                cursorShape: Qt.PointingHandCursor\n              }\n\n              TapHandler {\n                onTapped: root.showPassword = !root.showPassword\n              }\n            }\n\n            Text {\n              visible: root.formError !== ""\n              Layout.fillWidth: true\n              wrapMode: Text.WordWrap\n              text: root.formError\n              font.pixelSize: 13\n              color: "#C0392B"\n            }\n\n            PillButton {\n              Layout.fillWidth: true\n              label: "Log in"\n              onClicked: root.submit()\n            }\n          }\n        }\n\n        // ─── Switch to register ───\n        RowLayout {