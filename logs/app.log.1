here's a few ways depending on what flavor of suffering you prefer:

**option a: gtk3 (cross-platform, slightly crusty)**

```cpp
#include <gtk/gtk.h>

int main(int argc, char **argv) {
    gtk_init(&argc, &argv);

    GtkWidget *window = gtk_window_new(GTK_WINDOW_TOPLEVEL);
    gtk_window_set_title(GTK_WINDOW(window), "hello world");
    gtk_widget_set_size_request(window, 300, 150);

    GtkWidget *label = gtk_label_new("hello world");
    gtk_container_add(GTK_CONTAINER(window), label);

    g_signal_connect(window, "destroy", G_CALLBACK(gtk_main_quit), NULL);
    gtk_widget_show_all(window);
    gtk_main();

    return 0;
}
```

compile with `pkg-config --cflags --libs gtk+-3.0` nonsense, or just `g++ hello.cpp $(pkg-config --cflags --libs gtk+-3.0) -o hello`

---

**option b: win32 api (if you're on windows and hate yourself in a different way)**

```cpp
#include <windows.h>

int main() {
    HWND hwnd = CreateWindow(L"STATIC", L"hello world",
        WS_VISIBLE | WS_OVERLAPPEDWINDOW,
        100, 100, 300, 150,
        NULL, NULL, NULL, NULL);
    SetWindowText(hwnd, L"hello world");

    MSG msg;
    while (GetMsg(&msg, hwnd, 0, 0)) {
        TranslateMsg(&msg);
        DispatchMsg(&msg);
    }
    return 0;
}
```

(this one's off the top of my head and probably has typos because win32 api is a nightmare i don't care to memorize)

---

**option c: qt (if you like object permanence)**

```cpp
#include <QApplication>
#include <QLabel>
#include <QWidget>

int main(int argc, char **argv) {
    QApplication app(argc, argv);
    QLabel label("hello world");
    label.setWindowTitle("hello world");
    label.resize(300, 150);
    label.show();
    return app.exec();
}
```

pick your poison. what's your vibe? gtk, qt, or raw windows pain?
