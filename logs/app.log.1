st be after check-in.";\n      return;\n    }\n\n    const err = controller.bookRoom(controller.currentUserId, roomNum, checkIn.text, checkOut.text);\n    if (err) {\n      formError = err;\n      return;\n    }\n    booked = true;\n\n    if (payMethod === "later") {\n      payNote = "Your stay is booked. You can pay from the Reservations page.";\n      return;\n    }\n\n    // Charge the backend\'s own balance so it always matches what was stored.\n    const resNum = controller.lastBookedReservation();\n    const due = controller.balanceDue(resNum);\n    const payErr = controller.pay(resNum, payMethod, due.toFixed(2));\n    if (payErr)\n      payNote = "Your room is reserved, but the payment didn\'t go through (" + payErr + "). You can pay from the Reservations page.";\n    else\n      payNote = "Paid $" + due.toFixed(2) + (payMethod === "online" ? " online." : " at the counter.");\n  }\n\n  // ─── Pill button ───\n  component PillButton: Rectangle {\n    id: btn\n\n    property string label\n    property bool primary: true\n    signal clicked\n\n    implicitWidth: btnText.implicitWidth + 40\n    implicitHeight: 40\n    radius: height / 2\n    color: primary ? root.accent : (btnHover.hovered ? "#EFEFEF" : "white")\n    border.color: primary ? root.accent : "#E4E4E4"\n\n    Text {\n      id: btnText\n      anchors.centerIn: parent\n      text: btn.label\n      font.pixelSize: 14\n      font.weight: Font.Medium\n      color: btn.primary ? "#1E1E1E" : "#6B6B6B"\n    }\n\n    HoverHandler {\n      id: btnHover\n      cursorShape: Qt.PointingHandCursor\n    }\n\n    TapHandler {\n      onTapped: btn.clicked()\n    }\n  }\n\n  // ─── Labelled text input ───\n  component FormField: ColumnLayout {\n    id: field\n\n    property string label\n    property alias text: input.text\n    property alias placeholder: input.placeholderText\n    property alias validator: input.validator\n    property alias readOnly: input.readOnly\n    signal submitted\n\n    spacing: 4\n\n    Text 