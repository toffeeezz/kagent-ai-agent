le[T]:\n    name: str\n    getter: Callable[[T], Any]\n\n\n# ---------------------------------------------------------------- base model\nclass BaseListModel[T](QAbstractListModel):\n    """Generic list model driven by a list of Role(name, getter) specs."""\n\n    countChanged: pyqtSignal = pyqtSignal()\n\n    def __init__(self, roles: Sequence[Role[T]]) -> None:\n        super().__init__()\n        self._items: list[T] = []\n        self._roles: dict[int, Role[T]] = {\n            Qt.ItemDataRole.UserRole + 1 + i: role for i, role in enumerate(roles)\n        }\n\n    # ---- Qt plumbing\n    @override\n    def roleNames(self) -> dict[int, QByteArray]:\n        return {rid: QByteArray(r.name.encode()) for rid, r in self._roles.items()}\n\n    @override\n    def rowCount(self, parent: QModelIndex = QModelIndex()) -> int:\n        return 0 if parent.isValid() else len(self._items)\n\n    @override\n    def data(self, index: QModelIndex, role: int = Qt.ItemDataRole.DisplayRole) -> Any:\n        if not index.isValid() or not 0 <= index.row() < len(self._items):\n            return None\n        spec = self._roles.get(role)\n        return None if spec is None else to_qt(spec.getter(self._items[index.row()]))\n\n    # ---- QML-facing API\n    @pyqtProperty(int, notify=countChanged)\n    def count(self) -> int:\n        return len(self._items)\n\n    @pyqtSlot(int, result="QVariantMap")\n    def get(self, row: int) -> dict[str, Any]:\n        """model.get(i) -> {number: 101, tierId: 1, ...} (empty map if out of range)."""\n        if not 0 <= row < len(self._items):\n            return {}\n        item = self._items[row]\n        return {r.name: to_qt(r.getter(item)) for r in self._roles.values()}\n\n    @pyqtSlot(str, "QVariant", result="int")\n    def find(self, role_name: str, value: Any) -> int:\n        """Row of the first item whose role equals value, or -1."""\n        spec = next((r for r in self._roles.values() if r.name == role_name), None)\n        if spec is None:\n            return -1\n        for i, item in enumerate(self._items):\n            if to_qt(spec.getter(item)) == value:\n                return i\n        return -1\n\n    # ---- Python-facing API\n    def set_items(self, items: list[T]) -> None:\n        self.beginResetModel()\n        self._items = items\n        self.endResetModel()\n        self.countChanged.emit()\n\n    def clear(self) -> None:\n        self.set_items([])\n\n\n# ---------------------------------------------------------------- tiers\nclass RoomTierListModel(BaseListModel[RoomTierRow]):\n    def __init__(self) -> None:\n        super().__init__(\n            [\n                Role("tierId", lambda r: r.id),\n                Role("name", lambda r: r.name),\n                Role("basePrice", lambda r: r.base_price),\n            ]\n        )\n\n    def set_tiers(self, tiers: list[RoomTierRow]) -> None:\n        self.set_items(tiers)\n\n\n# ---------------------------------------------------------------- rooms\n\n\n@dataclass\nclass RoomModel:\n    number: int\n    tier: str\n    description: str\n    capacity: int\n    unit_price: float\n    base_price: float\n    total_price: float\n    is_maintenance: bool\n    image_path: str\n    reviews: list[ReviewRow]\n\n    @classmethod\n    def from_row(\n        cls, row: RoomRow, tier: RoomTierRow | None, reviews: list[ReviewRow]\n    ) -> Self:\n        base_price = tier.base_price if tier else Decimal(0)\n        total = row.unit_price + base_price\n        return cls(\n            number=row.room_num,\n            tier=tier.name if tier else "Unassigned",\n            description=row.description,\n            capacity=row.capacity,\n            unit_price=float(row.unit_price),\n            base_price=float(base_price),\n            total_price=float(total),\n            is_maintenance=bool(row.is_maintenance),\n            image_path=row.image_path or "",\n            reviews=reviews,\n        )\n\n\ndef _image_url(path: str) -> QUrl | str:\n    return QUrl.fromLocalFile(str((IMAGE_DIR / path).resolve())) if path else ""\n\n\ndef _average_rating(room: RoomModel) -> float:\n    return (\n        sum(r.rating for r in room.reviews) / len(room.reviews) if room.reviews else 0.0\n    )\n\n\nclass RoomListModel(BaseListModel[RoomModel]):\n    def __init__(self) -> None:\n        super().__init__(\n            [\n                Role("number", lambda r: r.number),\n                Role("tierName", lambda r: r.tier),\n                Role("description", lambda r: r.description),\n                Role("capacity", lambda r: r.capacity),\n                Role("unitPrice", lambda r: r.unit_price),\n                Role("isMaintenance", lambda r: r.is_maintenance),\n                Role("imagePath", lambda r: _image_url(r.image_path)),\n                Role("reviews", lambda r: r.reviews),  # -> list of maps, camelCase keys\n                Role("reviewCount", lambda r: len(r.reviews)),\n                Role("averageRating", _average_rating),\n                Role("unitPrice", lambda r: r.unit_price),\n                Role("basePrice", lambda r: r.base_price),\n                Role("totalPrice", lambda r: r.total_price),\n            ]\n        )\n\n    def set_rooms(self, rooms: list[RoomModel]) -> None:\n        self.set_items(rooms)\n\n\n# ---------------------------------------------------------------- reservations\nclass ReservationListModel(BaseListModel[ReservationRow]):\n    def __init__(self) -> None:\n        super().__init__(\n            [\n                Role("reservationNum", lambda r: r.reservation_num),\n                Role("userId", lambda r: r.user_id),\n                Role("roomNum", lambda r: r.room_num),\n                Role("createdAt", lambda r: r.created_at),\n                Role("dateIn", lambda r: r.date_in),\n                Role("dateOut", lambda r: r.date_out),\n                Role("nights", lambda r: (r.date_out - r.date_in).days),\n                Role("totalPayment", lambda r: r.total_payment),\n            ]\n        )\n\n    def set_reservations(self, reservations: list[ReservationRow]) -> None:\n        self.set_items(reservations)\n\n\n# ---------------------------------------------------------------- users\nclass UserListModel(BaseListModel[UserRow]):\n    def __init__(self) -> None:\n        super().__init__(\n            [\n                Role("userId", lambda r: r.id),\n                Role("fullName", lambda r: r.fullname),\n                Role("email", lambda r: r.email),\n                Role("phoneNum", lambda r: r.phone_num or ""),\n            ]\n        )\n\n    def set_users(self, users: list[UserRow]) -> None:\n        self.set_items(users)\n\n\n# ---------------------------------------------------------------- reviews\n@dataclass\nclass ReviewModel:\n    id: int\n    user_id: int | None\n    user_name: str\n    room_num: int | None\n    rating: int\n    text: str\n\n    @classmethod\n    def from_row(cls, row: ReviewRow, user: UserRow | None = None) -> Self:\n        return cls(\n            id=row.id,\n            user_id=row.user_id,\n            user_name=user.fullname if user else "Anonymous",\n            room_num=row.room_num,\n            rating=row.rating,\n            text=row.review,\n        )\n\n\ndef _initials(name: str) -> str:\n    parts = name.split()\n    return "".join(p[0] for p in parts[:2]).upper() or "?"\n\n\ndef _stars(rating: int, out_of: int = 5) -> str:\n    rating = max(0, min(out_of, rating))\n    return "★" * rating + "☆" * (out_of - rating)\n\n\nclass ReviewListModel(BaseListModel[ReviewModel]):\n    averageRatingChanged: pyqtSignal = pyqtSignal()\n\n    def __init__(self) -> None:\n        super().__init__(\n            [\n                Role("reviewId", lambda r: r.id),\n                Role("userId", lambda r: r.user_id),\n                Role("userName", lambda r: r.user_name),\n                Role("initials", lambda r: _initials(r.user_name)),\n                Role("roomNum", lambda r: r.room_num),\n                Role("rating", lambda r: r.rating),\n                Role("stars", lambda r: _stars(r.rating)),\n                Role("text", lambda r: r.text),\n                Role("isAnonymous", lambda r: r.user_id is None),\n            ]\n        )\n\n    # ---- aggregate for headers ("4.3 ★ from 12 reviews")\n    @pyqtProperty(float, notify=averageRatingChanged)\n    def averageRating(self) -> float:\n        if not self._items:\n            return 0.0\n        return sum(r.rating for r in self._items) / len(self._items)\n\n    @override\n    def set_items(self, items: list[ReviewModel]) -> None:\n        super().set_items(items)\n        self.averageRatingChanged.emit()\n\n    def set_reviews(\n        self,\n        reviews: list[ReviewRow],\n        users: dict[int, UserRow] | None = None,\n    ) -> None:\n        users = users or {}\n        self.set_items(\n            [\n                ReviewModel.from_row(r, users.get(r.user_id) if r.user_id else None)\n                for r in reviews\n            ]\n        )\n', expose_data=True)
