it using the given blueprints"""\n    tools = {bp.func.__name__: build_tool(name, bp) for bp in blueprints}\n    return ToolKit(\n        name=name, desc=desc, tools=tools, instructions=instructions, core=core\n    )\n', expose_data=True)
