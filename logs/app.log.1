2026-10-07 23:07:25 | DEBUG    | qasync._QThreadWorker:147 | Setting Future result: ToolResult(ok=True, message='File read successfully', data='import sqlite3\nfrom collections import defaultdict\nfrom collections.abc import Callable\nfrom datetime import date\nfrom typing import Any, cast\n\nfrom PyQt6.QtCore import (\n    QObject,\n    pyqtProperty,  # pyright: ignore[reportAttributeAccessIssue]\n    pyqtSignal,\n    pyqtSlot,  # pyright: ignore[reportAttributeAccessIssue]\n)\n\nfrom modules.database.backend import BackendProtocol, PaymentMethod\nfrom modules.database.database import RoomUnavailableError\nfrom modules.database.models import ReviewRow, RoomRow, UserRow\nfrom modules.gui.models import (\n    ReservationListModel,\n    ReviewListModel,\n    RoomListModel,\n    RoomModel,\n    RoomTierListModel,\n    UserListModel,\n    to_qt,\n)\n\n_DB_ERRORS = (sqlite3.Error, ValueError, RoomUnavailableError)\n\n\nclass Controller(QObject):\n    currentUserChanged: pyqtSignal = pyqtSignal()\n\n    def __init__(self, backend: BackendProtocol) -> None:\n        super().__init__()\n        self._backend: BackendProtocol = backend\n\n        # models\n        self._roomListModel: RoomListModel = RoomListModel()\n        self._availableRoomListModel: RoomListModel = RoomListModel()\n        self._roomTierListModel: RoomTierListModel = RoomTierListModel()\n        self._reservationListModel: ReservationListModel = ReservationListModel()\n        self._userListModel: UserListModel = UserListModel()\n        self._reviewListModel: ReviewListModel = ReviewListModel()\n\n        # session\n        self._currentUser: UserRow | None = None\n\n        # room filters\n        self._tierFilter: int = -1\n        self._dateIn: date | None = None\n        self._dateOut: date | None = None\n        self._guests: int = 1\n        self._minPrice: float = -1.0  # -1 = no limit\n        self._maxPrice: float = -1.0\n\n        # other filters\n        self._reservationUserFilter: int = -1\n        self._reviewRoomFilter: int = -1\n        self._reviewUserFilter: int = -1\n        self._lastSearch: tuple[date, date, int] | None = None\n        self._lastBookedNum: int = -1\n\n        self._seed_demo_data()\n        self.refreshAll()\n\n    # ================================================================ private helpers\n    @staticmethod\n    def _run(action: Callable[[], Any], error_prefix: str) -> str:\n        """Run a backend call. Returns "" on success, else a UI-ready message."""\n        try:\n            _ = action()\n        except _DB_ERRORS as e:\n            return f"{error_prefix}: {e}"\n        return ""\n\n    def _build_rooms(self, rows: list[RoomRow]) -> list[RoomModel]:\n        tiers = {t.id: t for t in self._backend.fetch_room_tiers()}\n        by_room: defaultdict[int, list[ReviewRow]] = defaultdict(list)\n        for review in self._backend.fetch_reviews():\n            if review.room_num is not None:\n                by_room[review.room_num].append(review)\n        return [\n            RoomModel.from_row(\n                r,\n                tiers.get(r.tier_id) if r.tier_id is not None else None,\n                by_room[r.room_num],\n            )\n            for r in rows\n        ]\n\n    def _load_rooms(self) -> None:\n        tier = None if self._tierFilter < 0 else self._tierFilter\n\n        if self._dateIn and self._dateOut:\n            rows = self._backend.fetch_available_rooms(\n                self._dateIn, self._dateOut, self._guests\n            )\n            rows = [\n                r\n                for r in rows\n                if not r.is_maintenance and (tier is None or r.tier_id == tier)\n            ]\n        else:\n            rows = [\n                r for r in self._backend.fetch_rooms(tier) if r.capacity >= self._guests\n            ]\n\n        rooms = self._build_rooms(rows)\n        # price filter is on the nightly total (unit + tier base), the same number the card shows\n        rooms = [\n            r\n            for r in rooms\n            if (self._minPrice < 0 or r.total_price >= self._minPrice)\n            and (self._maxPrice < 0 or r.total_price <= self._maxPrice)\n        ]\n        self._roomListModel.set_rooms(rooms)\n\n    def _set_current_user(self, user: UserRow | None) -> None:\n        self._currentUser = user\n        self.currentUserChanged.emit()\n\n    def _seed_demo_data(self) -> None:\n        if self._backend.fetch_room_tiers():\n            return  # already seeded\n\n        standard = self._backend.add_room_tier("Standard", "150.00")\n        deluxe = self._backend.add_room_tier("Deluxe", "300.00")\n        suite = self._backend.add_room_tier("Suite", "600.00")\n        user = self._backend.register_user("Demo User", "demo@hotel.com", None, "demo")\n\n        _ = self._backend.add_room(\n            room_num=101,\n            tier_id=deluxe,\n            description="A basic deluxe room",\n            capacity=3,\n            unit_price="400.00",\n            image_path="deluxe_room1.jpg",\n        )\n        _ = self._backend.add_room(\n            room_num=102,\n            tier_id=standard,\n            description="Cozy room with a queen bed",\n            capacity=2,\n            unit_price="150.00",\n            image_path="basic_room2.jpg",\n        )\n        _ = self._backend.add_room(\n            room_num=103,\n            tier_id=standard,\n            description="Twin room under renovation",\n            capacity=2,\n            unit_price="150.00",\n            is_maintenance=True,\n            image_path="basic_room1.jpg",\n        )\n        _ = self._backend.add_room(\n            room_num=201,\n            tier_id=suite,\n            description="Top-floor suite with a balcony",\n            capacity=4,\n            unit_price="650.00",\n            image_path="suite_room1.jpg",\n        )\n\n        _ = self._backend.add_review(user, 101, 5, "Spotless and quiet.")\n        _ = self._backend.add_review(user, 102, 3, "Decent, but a bit noisy.")\n        _ = self._backend.add_reservation(\n            user, 101, date(2026, 12, 10), date(2026, 12, 14)\n        )\n\n    # ================================================================ models exposed to QML\n    @pyqtProperty(QObject, constant=True)\n    def roomListModel(self) -> QObject:\n        return self._roomListModel\n\n    @pyqtProperty(QObject, constant=True)\n    def availableRoomListModel(self) -> QObject:\n        return self._availableRoomListModel\n\n    @pyqtProperty(QObject, constant=True)\n    def roomTierListModel(self) -> QObject:\n        return self._roomTierListModel\n\n    @pyqtProperty(QObject, constant=True)\n    def reservationListModel(self) -> QObject:\n        return self._reservationListModel\n\n    @pyqtProperty(QObject, constant=True)\n    def userListModel(self) -> QObject:\n        return self._userListModel\n\n    @pyqtProperty(QObject, constant=True)\n    def reviewListModel(self) -> QObject:\n        return self._reviewListModel\n\n    # ================================================================ loaders\n    @pyqtSlot()\n    def refreshAll(self) -> None:\n        self.refreshTiers()\n        self.refreshRooms(self._tierFilter)\n        self.refreshReservations(self._reservationUserFilter)\n        self.refreshUsers()\n        self.refreshReviews(self._reviewRoomFilter, self._reviewUserFilter)\n\n    @pyqtSlot()\n    def refreshTiers(self) -> None:\n        self._roomTierListModel.set_tiers(self._backend.fetch_room_tiers())\n\n    @pyqtSlot(int)\n    def refreshRooms(self, tier_id: int = -1) -> None:\n        """tier_id = -1 loads every tier. Other active filters are kept."""\n        self._tierFilter = tier_id\n        self._load_rooms()\n\n    @pyqtSlot(int)\n    def refreshReservations(self, user_id: int = -1) -> None:\n        """user_id = -1 loads every reservation."""\n        self._reservationUserFilter = user_id\n        self._reservationListModel.set_reservations(\n            self._backend.fetch_reservations(user_id=None if user_id < 0 else user_id)\n        )\n\n    @pyqtSlot()\n    def refreshUsers(self) -> None:\n        self._userListModel.set_users(self._backend.fetch_all_users())\n\n    @pyqtSlot(int, int)\n    def refreshReviews(self, room_num: int = -1, user_id: int = -1) -> None:\n        """-1 means "don\'t filter" for either argument."""\n        self._reviewRoomFilter = room_num\n        self._reviewUserFilter = user_id\n\n        reviews = self._backend.fetch_reviews(\n            room_num=None if room_num < 0 else room_num,\n            user_id=None if user_id < 0 else user_id,\n        )\n\n        users: dict[int, UserRow] = {}\n        for uid in {r.user_id for r in reviews if r.user_id is not None}:\n            if (user := self._backend.fetch_user(uid)) is not None:\n                users[uid] = user\n\n        self._reviewListModel.set_reviews(reviews, users)\n\n    # ================================================================ room filters\n    @pyqtSlot(int, str, str, int, float, float, result="QString")\n    def setRoomFilters(\n        self,\n        tier_id: int,\n        date_in: str,\n        date_out: str,\n        guests: int,\n        min_price: float,\n        max_price: float,\n    ) -> str:\n        """Empty date strings and negative prices mean "no filter"."""\n        d_in = d_out = None\n        if date_in or date_out:\n            try:\n                d_in, d_out = date.fromisoformat(date_in), date.fromisoformat(date_out)\n            except ValueError:\n                return "Enter both dates as YYYY-MM-DD."\n            if d_out <= d_in:\n                return "Check-out must be after check-in."\n            if d_in < date.today():\n                return "Check-in can\'t be in the past."\n        if 0 <= max_price < min_price:\n            return "Min price can\'t be higher than max price."\n\n        self._tierFilter = tier_id\n        self._dateIn, self._dateOut = d_in, d_out\n        self._guests = max(guests, 1)\n        self._minPrice, self._maxPrice = min_price, max_price\n        self._load_rooms()\n        return ""\n\n    @pyqtSlot()\n    def clearRoomFilters(self) -> None:\n        """Resets dates, guests and price. The tier filter is left alone."""\n        self._dateIn = self._dateOut = None\n        self._guests = 1\n        self._minPrice = self._maxPrice = -1.0\n        self._load_rooms()\n\n    # ================================================================ current user & auth\n    @pyqtProperty(bool, notify=currentUserChanged)\n    def isLoggedIn(self) -> bool:\n        return self._currentUser is not None\n\n    @pyqtProperty(int, notify=currentUserChanged)\n    def currentUserId(self) -> int:\n        return self._currentUser.id if self._currentUser else -1\n\n    @pyqtProperty(str, notify=currentUserChanged)\n    def currentUserName(self) -> str:\n        return self._currentUser.fullname if self._currentUser else ""\n\n    @pyqtProperty(str, notify=currentUserChanged)\n    def currentUserEmail(self) -> str:\n        return self._currentUser.email if self._currentUser else ""\n\n    @pyqtSlot(str, str, result="QString")\n    def login(self, email: str, password: str) -> str:\n        user = self._backend.auth_user(email.strip(), password)\n        if user is None:\n            return "Invalid email or password."\n        self._set_current_user(user)\n        return ""\n\n    @pyqtSlot()\n    def logout(self) -> None:\n        self._set_current_user(None)\n\n    @pyqtSlot(str, str, str, str, result="QString")\n    def register(self, fullname: str, email: str, phone: str, password: str) -> str:\n        if not fullname.strip() or not email.strip() or not password:\n            return "Name, email and password are required."\n        try:\n            user_id = self._backend.register_user(\n                fullname.strip(), email.strip(), phone.strip() or None, password\n            )\n        except _DB_ERRORS as e:\n            return f"Could not register: {e}"  # e.g. duplicate email\n        self.refreshUsers()\n        self._set_current_user(self._backend.fetch_user(user_id))\n        return ""\n\n    @pyqtSlot(str, str, result="QString")\n    def changePassword(self, old_password: str, new_password: str) -> str:\n        if self._currentUser is None:\n            return "You are not logged in."\n        if not new_password:\n            return "New password can\'t be empty."\n        ok = self._backend.change_password(\n            self._currentUser.id, old_password, new_password\n        )\n        return "" if ok else "Current password is incorrect."\n\n    @pyqtSlot(int, str, str, str, result="QString")\n    def updateProfile(self, user_id: int, fullname: str, email: str, phone: str) -> str:\n        err = self._run(\n            lambda: self._backend.update_user(\n                user_id,\n                fullname=fullname.strip(),\n                email=email.strip(),\n                phone_num=phone.strip() or None,\n            ),\n            "Could not update profile",\n        )\n        if err:\n            return err\n        self.refreshUsers()\n        if self._currentUser and self._currentUser.id == user_id:\n            self._set_current_user(self._backend.fetch_user(user_id))\n        return ""\n\n    @pyqtSlot(int, result="QString")\n    def deleteUser(self, user_id: int) -> str:\n        err = self._run(\n            lambda: self._backend.delete_user(user_id), "Could not delete user"\n        )\n        if err:\n            return err\n        if self._currentUser and self._currentUser.id == user_id:\n            self._set_current_user(None)\n        self.refreshAll()\n        return ""\n\n    # ================================================================ availability & booking\n    @pyqtSlot(str, str, int, result="QString")\n    def searchAvailableRooms(self, date_in: str, date_out: str, guests: int) -> str:\n        """Dates are ISO strings from QML: Qt.formatDate(d, "yyyy-MM-dd")."""\n        try:\n            d_in, d_out = date.fromisoformat(date_in), date.fromisoformat(date_out)\n        except ValueError:\n            return "Please pick valid dates."\n        if d_out <= d_in:\n            return "Check-out must be after check-in."\n        if d_in < date.today():\n            return "Check-in can\'t be in the past."\n\n        self._lastSearch = (d_in, d_out, max(guests, 1))\n        rows = self._backend.fetch_available_rooms(d_in, d_out, max(guests, 1))\n        self._availableRoomListModel.set_rooms(self._build_rooms(rows))\n        return ""\n\n    @pyqtSlot()\n    def clearAvailableRooms(self) -> None:\n        self._lastSearch = None\n        self._availableRoomListModel.clear()\n\n    @pyqtSlot(int, int, str, str, result="QString")\n    def bookRoom(self, user_id: int, room_num: int, date_in: str, date_out: str) -> str:\n        try:\n            d_in, d_out = date.fromisoformat(date_in), date.fromisoformat(date_out)\n        except ValueError:\n            return "Please pick valid dates."\n        if d_out <= d_in:\n            return "Check-out must be after check-in."\n\n        booked: list[int] = []\n        err = self._run(\n            lambda: booked.append(\n                self._backend.add_reservation(user_id, room_num, d_in, d_out)\n            ),\n            "Could not book room",\n        )\n        if err:\n            return err\n        self._lastBookedNum = booked[0] if booked else -1\n\n        self.refreshReservations(self._reservationUserFilter)\n        self.refreshRooms(self._tierFilter)  # keep the filtered room list current\n        if self._lastSearch:  # the booked room should drop out of the results\n            s_in, s_out, guests = self._lastSearch\n            _ = self.searchAvailableRooms(s_in.isoformat(), s_out.isoformat(), guests)\n        return ""\n\n    @pyqtSlot(result="int")\n    def lastBookedReservation(self) -> int:\n        """Reservation number created by the most recent successful bookRoom()."""\n        return self._lastBookedNum\n\n    @pyqtSlot(int, result="QVariantMap")\n    def roomDetails(self, room_num: int) -> dict[str, Any]:\n        """One room as a map with the same keys RoomCard needs ({} if not found)."""\n        row = self._backend.fetch_room(room_num)\n        if row is None:\n            return {}\n        model = RoomListModel()\n        model.set_rooms(self._build_rooms([row]))\n        return model.get(0)\n\n    @pyqtSlot(int, result="QString")\n    def cancelReservation(self, reservation_num: int) -> str:\n        err = self._run(\n            lambda: self._backend.delete_reservation(reservation_num),\n            "Could not cancel reservation",\n        )\n        if err:\n            return err\n        self.refreshReservations(self._reservationUserFilter)\n        self.refreshRooms(self._tierFilter)\n        return ""\n\n    # ================================================================ payments\n    @pyqtSlot(int, result="QVariantList")\n    def payments(self, reservation_num: int) -> list[Any]:\n        """List of maps: {id, reservationNum, method, amount, date}."""\n        return [\n            to_qt(p.model_dump()) for p in self._backend.fetch_payments(reservation_num)\n        ]\n\n    @pyqtSlot(int, result="float")\n    def totalPaid(self, reservation_num: int) -> float:\n        return float(self._backend.fetch_total_paid(reservation_num))\n\n    @pyqtSlot(int, result="float")\n    def balanceDue(self, reservation_num: int) -> float:\n        due = self._backend.fetch_balance_due(reservation_num)\n        return float(due) if due is not None else 0.0\n\n    @pyqtSlot(int, str, str, result="QString")\n    def pay(self, reservation_num: int, method: str, amount: str) -> str:\n        """method: "counter" | "online". amount is a string to avoid float drift."""\n        if method not in ("counter", "online"):\n            return "Unknown payment method."\n        err = self._run(\n            lambda: self._backend.add_payment(\n                reservation_num, cast(PaymentMethod, method), amount\n            ),\n            "Payment failed",\n        )\n        if err:\n            return err\n        self.refreshReservations(self._reservationUserFilter)\n        return ""\n\n    # ================================================================ reviews\n    @pyqtSlot(int, int, int, str, result="QString")\n    def addReview(self, user_id: int, room_num: int, rating: int, text: str) -> str:\n        if not text.strip():\n            return "Please write a short review."\n        if not 1 <= rating <= 5:\n            return "Please choose a rating from 1 to 5."\n        err = self._run(\n            lambda: self._backend.add_review(user_id, room_num, rating, text.strip()),\n            "Could not save review",\n        )\n        if err:\n            return err\n        self.refreshRooms(self._tierFilter)\n        self.refreshReviews(self._reviewRoomFilter, self._reviewUserFilter)\n        return ""\n\n    @pyqtSlot(int, result="QString")\n    def deleteReview(self, review_id: int) -> str:\n        err = self._run(\n            lambda: self._backend.delete_review(review_id), "Could not delete review"\n        )\n        if err:\n            return err\n        self.refreshRooms(self._tierFilter)\n        self.refreshReviews(self._reviewRoomFilter, self._reviewUserFilter)\n        return ""\n\n    # ================================================================ admin: tiers & rooms\n    @pyqtSlot(str, str, result="QString")\n    def addTier(self, name: str, base_price: str) -> str:\n        if not name.strip():\n            return "Tier name is required."\n        err = self._run(\n            lambda: self._backend.add_room_tier(name.strip(), base_price),\n            "Could not add tier",\n        )\n        if err:\n            return err\n        self.refreshTiers()\n        return ""\n\n    @pyqtSlot(int, result="QString")\n    def deleteTier(self, tier_id: int) -> str:\n        err = self._run(\n            lambda: self._backend.delete_room_tier(tier_id), "Could not delete tier"\n        )\n        if err:\n            return err\n        self.refreshTiers()\n        self.refreshRooms(-1 if self._tierFilter == tier_id else self._tierFilter)\n        return ""\n\n    @pyqtSlot(int, int, str, int, str, str, result="QString")\n    def addRoom(\n        self,\n        room_num: int,\n        tier_id: int,\n        description: str,\n        capacity: int,\n        unit_price: str,\n        image_path: str,\n    ) -> str:\n        err = self._run(\n            lambda: self._backend.add_room(\n                room_num=room_num,\n                tier_id=tier_id,\n                description=description.strip(),\n                capacity=capacity,\n                unit_price=unit_price,\n                image_path=image_path or None,\n            ),\n            "Could not add room",\n        )\n        if err:\n            return err\n        self.refreshRooms(self._tierFilter)\n        return ""\n\n    @pyqtSlot(int, bool, result="QString")\n    def setMaintenance(self, room_num: int, on: bool) -> str:\n        err = self._run(\n            lambda: self._backend.update_room(room_num, is_maintenance=on),\n            "Could not update room",\n        )\n        if err:\n            return err\n        self.refreshRooms(self._tierFilter)\n        return ""\n\n    @pyqtSlot(int, result="QString")\n    def deleteRoom(self, room_num: int) -> str:\n        err = self._run(\n            lambda: self._backend.delete_room(room_num), "Could not delete room"\n        )\n        if err:\n            return err\n        self.refreshAll()\n        return ""\n', expose_data=True)
