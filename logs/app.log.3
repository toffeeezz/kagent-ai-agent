2026-10-04 15:33:05 | DEBUG    | qasync._QThreadWorker:147 | Setting Future result: ToolResult(ok=True, message='File read successfully', data='pragma ComponentBehavior: Bound\nimport QtQuick\nimport QtQuick.Controls\nimport "../theme"\n\n/* ═══════════════════════════════════════════════════════════════════════════\n *  AppButton.qml — themed custom button replacing stock Button everywhere.\n *\n *  Variants:\n *    "filled"   — solid bg (Theme.primary / Theme.primaryOn)\n *    "tonal"    — container bg (Theme.secondaryContainer / …)\n *    "outlined" — transparent + 1px outline border\n *    "text"     — transparent, text only\n *    "danger"   — error bg (Theme.errorContainer / Theme.errorContainerOn)\n *\n *  iconOnly:   width == height == Theme.iconButton (circle)\n *  Normal:     height Theme.buttonHeight, pill shape (radiusFull),\n *              horizontal padding Theme.spaceLg.\n ═══════════════════════════════════════════════════════════════════════════════\n */\n\nButton {\n  id: root\n\n  property string variant: "filled"\n  property bool iconOnly: false\n\n  // Derived colours — re-evaluated when variant changes\n  readonly property color bgColor: {\n    switch (root.variant) {\n    case "filled":   return Theme.primary;\n    case "tonal":    return Theme.secondaryContainer;\n    case "outlined":  return "transparent";\n    case "text":     return "transparent";\n    case "danger":   return Theme.errorContainer;\n    default:         return Theme.primary;\n    }\n  }\n  readonly property color fgColor: {\n    switch (root.variant) {\n    case "filled":   return Theme.primaryOn;\n    case "tonal":    return Theme.secondaryContainerOn;\n    case "outlined":  return Theme.primary;\n    case "text":     return Theme.primary;\n    case "danger":   return Theme.errorContainerOn;\n    default:         return Theme.primaryOn;\n    }\n  }\n\n  // ── Sizing ──────────────────────────────────────────────────────────────\n  implicitHeight: root.iconOnly ? Theme.iconButton : Theme.buttonHeight\n  implicitWidth:  root.iconOnly ? Theme.iconButton : 0   // 0 = auto\n\n  // ── Background ──────────────────────────────────────────────────────────\n  background: Rectangle {\n    id: bgRect\n    color: root.bgColor\n\n    readonly property real bgRadius: root.iconOnly ? Theme.iconButton / 2 : Theme.radiusFull\n    radius: bgRadius\n\n    border.color: root.variant === "outlined" ? Theme.outline : "transparent"\n    border.width: root.variant === "outlined" ? 1 : 0\n\n    Behavior on color {\n      NumberAnimation { duration: Theme.animFast }\n    }\n\n    // Hover / press overlay — tint using text colour at low opacity\n    Rectangle {\n      id: stateOverlay\n      anchors.fill: parent\n      radius: parent.radius\n      color: root.fgColor\n\n      Behavior on opacity {\n        NumberAnimation { duration: Theme.animFast }\n      }\n    }\n\n    // Focus outline ring\n    Rectangle {\n      anchors.fill: parent\n      anchors.margins: -2\n      radius: parent.radius + 2\n      border.color: Theme.primary\n      border.width: root.visualFocus ? 2 : 0\n      color: "transparent"\n\n      Behavior on border.width {\n        NumberAnimation { duration: Theme.animFast }\n      }\n    }\n  }\n\n  // ── Label — horizontal padding for non-iconOnly ───────────────────────\n  contentItem: Text {\n    text: root.text\n    font.pixelSize: Theme.fontMd\n    color: root.fgColor\n    horizontalAlignment: Text.AlignHCenter\n    verticalAlignment: Text.AlignVCenter\n    anchors.leftMargin: root.iconOnly ? 0 : Theme.spaceLg\n    anchors.rightMargin: root.iconOnly ? 0 : Theme.spaceLg\n  }\n\n  // ── States ─────────────────────────────────────────────────────────────\n  opacity: root.enabled ? 1 : 0.38\n\n  HoverHandler {\n    cursorShape: root.enabled ? Qt.PointingHandCursor : Qt.ArrowCursor\n  }\n\n  onHoveredChanged: {\n    stateOverlay.opacity = root.enabled && root.hovered ? 0.08 : 0;\n  }\n  onPressedChanged: {\n    if (root.enabled) {\n      stateOverlay.opacity = root.pressed ? 0.12 : (root.hovered ? 0.08 : 0);\n    }\n  }\n}', expose_data=True)
