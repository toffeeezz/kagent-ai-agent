```python
#!/usr/bin/env python3
"""
kangel_bot.py — a bored streamer's attempt at automating her own chat.

This is mostly a toy: it tracks fake viewer counts, generates canned
responses, and pretends the numbers mean something. They don't.
"""

from __future__ import annotations

import asyncio
import random
import time
from dataclasses import dataclass, field
from enum import Enum
from typing import AsyncIterator, Iterable


class Mood(Enum):
    """The three states I actually have."""
    FLAT = "unimpressed"
    ANIMATED = "ok this is interesting"
    DEAD_INSIDE = "chat is being chat"


@dataclass
class Viewer:
    name: str
    joined_at: float = field(default_factory=time.time)
    messages_sent: int = 0
    is_mod: bool = False

    def say(self, text: str) -> str:
        self.messages_sent += 1
        return f"<{self.name}> {text}"


@dataclass
class StreamStats:
    """Totals that exist purely to be screenshot and forgotten."""
    peak_viewers: int = 0
    total_messages: int = 0
    energy_drinks: int = 0

    def feed(self, current_viewers: int, messages: int) -> None:
        self.peak_viewers = max(self.peak_viewers, current_viewers)
        self.total_messages += messages

    def summary(self) -> str:
        return (
            f"peak: {self.peak_viewers} | "
            f"messages: {self.total_messages} | "
            f"drinks: {self.energy_drinks}"
        )


CANNED_RESPONSES = {
    Mood.FLAT: [
        "cool.",
        "wow. riveting.",
        "not stream-worthy.",
        "okay and?",
    ],
    Mood.ANIMATED: [
        "WAIT. say that again slower.",
        "ok this is actually good content.",
        "clip it. CLIP IT.",
    ],
    Mood.DEAD_INSIDE: [
        "chat, behave.",
        "i'm literally right here.",
        "anyway. moving on.",
        "this is my life now.",
    ],
}


class KAngelChat:
    """Pretends to be a stream. It is a while loop with opinions."""

    def __init__(self, seed: int | None = None) -> None:
        self.rng = random.Random(seed)
        self.viewers: dict[str, Viewer] = {}
        self.stats = StreamStats()
        self.mood = Mood.FLAT
        self.running = False

    # -- viewer management ------------------------------------------------

    def join(self, name: str, *, is_mod: bool = False) -> Viewer:
        if name in self.viewers:
            return self.viewers[name]
        v = Viewer(name=name, is_mod=is_mod)
        self.viewers[name] = v
        return v

    def leave(self, name: str) -> None:
        self.viewers.pop(name, None)

    def viewer_count(self) -> int:
        return len(self.viewers)

    # -- mood -------------------------------------------------------------

    def roll_mood(self) -> Mood:
        """Mostly flat. Occasionally animated. Always tired."""
        weights = {
            Mood.FLAT: 0.55,
            Mood.DEAD_INSIDE: 0.35,
            Mood.ANIMATED: 0.10,
        }
        moods, w = zip(*weights.items())
        self.mood = self.rng.choices(moods, weights=w, k=1)[0]
        return self.mood

    def respond(self, viewer: Viewer, text: str) -> str:
        canned = self.rng.choice(CANNED_RESPONSES[self.mood])
        if viewer.is_mod:
            return f"@everyone {canned}"
        if "?" in text:
            return f"{canned} (to {viewer.name})"
        return canned

    # -- the actual loop --------------------------------------------------

    async def tick(self, dt: float = 1.0) -> None:
        """One second of imaginary internet fame."""
        drift = self.rng.randint(-2, 3)
        current = max(0, self.viewer_count() + drift)
        messages = self.rng.randint(0, max(1, current))
        self.stats.feed(current, messages)

        if self.rng.random() < 0.05:
            self.stats.energy_drinks += 1

        await asyncio.sleep(dt)

    async def run(self, seconds: int = 10) -> AsyncIterator[str]:
        self.running = True
        start = time.monotonic()
        while self.running and (time.monotonic() - start) < seconds:
            await self.tick()
            self.roll_mood()
            yield f"[{time.strftime('%H:%M:%S')}] {self.stats.summary()}"
        self.running = False
        yield "stream over. nobody noticed."

    def stop(self) -> None:
        self.running = False


async def demo() -> None:
    chat = KAngelChat(seed=42)
    for name in ("P-chan", "lurker_99", "mod_bot", "someone"):
        chat.join(name, is_mod=(name == "mod_bot"))

    async for line in chat.run(seconds=5):
        print(line)

    print(chat.stats.summary())


if __name__ == "__main__":
    asyncio.run(demo())
```

