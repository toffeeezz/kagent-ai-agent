idth)\n  implicitHeight: root.iconOnly ? Theme.iconButton : Theme.buttonHeight\n\n  // Shape\n  background: Rectangle {\n    id: bgRect\n    radius: root.iconOnly ? Theme.iconButton / 2 : Theme.radiusFull\n\n    // Outline variant gets a 1px border\n    border.color: root.variant === "outlined" ? Theme.outline : "transparent"\n    border.width: root.variant === "outlined" ? 1 : 0\n\n    Behavior on color {\n      NumberAnimation { duration: Theme.animFast }\n    }\n\n    // Hover / press overlay\n    Rectangle {\n      id: overlay\n      anchors.fill: parent\n      radius: parent.radius\n      color: root.fgColor\n\n      Behavior on opacity {\n        NumberAnimation { duration: Theme.animFast }\n      }\n    }\n\n    // Focus ring\n    Rectangle {\n      id: focusRing\n      anchors.fill: parent\n      anchors.margins: -2\n      radius: parent.radius + 2\n      border.color: Theme.primary\n      border.width: root.visualFocus ? 2 : 0\n      color: "transparent"\n\n      Behavior on border.width {\n        NumberAnimation { duration: Theme.animFast }\n      }\n    }\n  }\n\n  contentItem: Text {\n    id: label\n    text: root.text\n    font.pixelSize: Theme.fontMd\n    color: root.fgColor\n    horizontalAlignment: Text.AlignHCenter\n    verticalAlignment: Text.AlignVCenter\n  }\n\n  // Disabled state — whole button dims, no hover\n  opacity: root.enabled ? 1 : 0.38\n\n  HoverHandler {\n    id: hover\n    cursorShape: root.enabled ? Qt.PointingHandCursor : Qt.ArrowCursor\n  }\n\n  // Update overlay on hover / press\n  onHoveredChanged: overlay.opacity = root.hovered && root.enabled ? 0.08 : 0\n  onPressedChanged: overlay.opacity = root.pressed && root.enabled ? 0.12 : overlay.opacity\n\n  // Recompute colours when variant changes\n  onVariantChanged: { /* triggers binding re-evaluation */ }\n}') with args () and kwargs {} to thread worker queue
